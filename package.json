{
  "name": "@horsecoder/visual-core",
  "version": "0.3.7",
  "description": "可视化核心",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "repository": "git@git.horsecoder.com:visual-core/visual-core.git",
  "license": "MIT",
  "scripts": {
    "start": "parcel demo/index.html --out-dir deploy",
    "lint": "elint lint \"(src|demo)/**/*.(js|jsx|ts|tsx)\" --prettier",
    "lint:fix": "yarn lint --fix",
    "lint:commit": "yarn lint && elint lint commit",
    "build": "yarn clean:lib && yarn build:lib",
    "build:lib": "rollup -c",
    "clean": "yarn clean:demo && yarn clean:lib",
    "clean:demo": "rimraf .cache && rimraf deploy",
    "clean:lib": "rimraf dist",
    "prepublishOnly": "yarn build"
  },
  "husky": {
    "hooks": {
      "commit-msg": "npm run lint:commit"
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^4.5.0",
    "@babel/core": "^7.13.8",
    "@babel/preset-env": "^7.13.8",
    "@commitlint/config-angular": "^12.0.1",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^17.1.0",
    "@rollup/plugin-image": "^2.0.6",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^11.2.0",
    "@types/lodash-es": "^4.17.4",
    "@types/react": "^16.14.4",
    "@types/react-dom": "^16.9.11",
    "@types/react-redux": "^7.1.16",
    "@types/styled-components": "^5.1.7",
    "@typescript-eslint/eslint-plugin": "^4.15.2",
    "@typescript-eslint/parser": "^4.15.2",
    "antd": "^4.24.5",
    "core-js": "3",
    "elint": "^2.0.1",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "husky": "^4.3.8",
    "parcel": "^1.12.4",
    "react": "^16.8.0 || ^17.0.0",
    "react-dom": "^16.14.0",
    "rimraf": "^3.0.2",
    "rollup": "^2.40.0",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.30.0",
    "tslib": "^2.1.0",
    "typescript": "^4.2.2"
  },
  "peerDependencies": {
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "rc-tooltip": "^5.1.0",
    "react-inlinesvg": "^2.2.2",
    "react-is": "^16.13.0",
    "react-redux": "^7.2.2",
    "redux": "^4.0.5",
    "redux-devtools-extension": "^2.13.9",
    "redux-thunk": "^2.3.0",
    "reselect": "^4.0.0",
    "styled-components": "^5.2.1"
  },
  "publishConfig": {
    "registry": "http://central.horsecoder.com:8081/repository/npm-private-horse-code/"
  }
}
