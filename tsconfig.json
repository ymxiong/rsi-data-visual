{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@": ["src"]
    },
    "strict": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "noImplicitAny": true,
    "target": "esnext",
    "lib": ["dom", "es2017"]
  },
  "exclude": ["node_modules", "lib", "es"]
}
